# Copy to .env (gitignored) for signed local builds: sfos/build.sh --sign.
# sfos/sign.sh reads the signing key from the keepassrx-signing.asc
# attachment of this KeePass entry, and its passphrase from the entry's
# password. Without KEEPASSRX_SIGNING_KDBX, it uses RPM_SIGNING_KEY and
# RPM_SIGNING_PASSPHRASE from the environment instead.
KEEPASSRX_SIGNING_KDBX=/path/to/passwords.kdbx
KEEPASSRX_SIGNING_ENTRY="Development/KeePassRX RPM signing"
# Optional key file for the database.
KEEPASSRX_SIGNING_KEYFILE=
