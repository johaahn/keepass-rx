msgstr "Скасувати"

msgid "Change settings based on your preferences."
msgstr "Змінити налаштування згідно з Вашими уподобаннями."

msgid "Enable database locking"
msgstr "Активувати блокування бази даних"

msgid ""
"Securely lock and unlock database with a short passcode. Requires restart to "
"take effect."
msgstr ""
"Безпечно блокуйте та розблоковуйте базу даних коротким кодом. Для активації "
"потрібне перезавантаження."

msgid "Enable Accents"
msgstr "Активувати акцентні кольори"

msgid ""
"Set header color and name according to database settings. Compatible with "
"KeePassXC."
msgstr ""
"Встановіть колір заголовка та назву відповідно до налаштувань бази даних. "
"Сумісний з KeePassXC."

msgid "Show the \"Recycle bin\" group"
msgstr "Показати групу \"Кошик\""

msgid "This group contains all the deleted entries"
msgstr "Ця група містить усі видаленні записи"

msgid "Fuzzy Search"
msgstr "Нечіткий пошук"

msgid ""
"Use fuzzy search to find entries. If disabled, search only matches exact "
"case insensitive text."
msgstr ""
"Використовувати нечіткий пошук для пошуку записів. Якщо вимкнено, пошук "
"відбувається лише за точним текстом без урахування регістру."

msgid "Key Loaded"
msgstr "Завантажені ключі"

msgid "Remove Key"
msgstr "Вилучити ключ"

msgid "Use Key"
msgstr "Використати ключ"

msgid "Automatically detected a key file for this database."
msgstr "Автоматично визначений ключовий файл для цієї бази даних."

msgid "A key file will be used to open this database."
msgstr "Ключовий файл буде використаний для відкриття цієї бази даних."

msgid "Select Key File"
msgstr "Виберіть ключовий файл"

msgid "Enter the database master password"
msgstr "Вкажіть майстер-пароль бази даних"

msgid "Master Password"
msgstr "Майстер-пароль"

msgid "Open"
msgstr "Відкрити"

msgid "Hide Password"
msgstr "Приховати пароль"

msgid "Show Password"
msgstr "Показати пароль"

msgid "Opening"
msgstr "Відкривається"

msgid "Manual path set."
msgstr "Шлях встановлений вручну."

msgid ""
"The passcode is the first five characters of the database password (or the "
"whole password if less than five characters)."
msgstr ""
"Код доступу — це перші п’ять символів пароля бази даних (або весь пароль, "
"якщо він менш як п'ять символів)."

msgid "Passcode"
msgstr "Код доступу"

msgid "Unlock"
msgstr "Розблокувати"

msgid "Securely Unlocking"
msgstr "Безпечне розблокування"

msgid "Securely Locking"
msgstr "Безпечне блокування"

msgid "Database Not Opening?"
msgstr "База даних не відкривається?"

msgid "Entry Notes"
msgstr "Примітки до запису"

msgid "Note copied to clipboard"
msgstr "Нотатка скопійована в буфер обміну"

msgid "Unable to export attachment."
msgstr "Не вдалося експортувати вкладення."

msgid "Entry Attachments"
msgstr "Вкладення до запису"

msgid "Export Attachment"
msgstr "Експорт вкладення"

msgid "Attachment Not Viewable"
msgstr "Вкладення не відображається"

msgid "KeePassRX cannot view this %1 attachment, but it can be exported."
msgstr ""
"KeePassRX не може відкрити це вкладення %1, але його можна експортувати."

msgid "KeePassRX cannot view this attachment, but it can be exported."
msgstr ""
"KeePassRX не може відкрити цей файл-вкладення, але його можна експортувати."

msgid "Export"
msgstr "Експорт"

msgid "%1 ready to export."
msgstr "%1 готово до експорту."

msgid "%1 exported."
msgstr "%1 експортовано."

